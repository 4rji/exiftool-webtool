[Unit]
Description=Metadata Cleaner web tool (exiftool / qpdf / mat2)
After=network.target

[Service]
Type=simple
User=exiftool-webtool
Group=exiftool-webtool
WorkingDirectory=/opt/exiftool-webtool
Environment=HOME=/var/cache/exiftool-webtool
Environment=CLEANER_BIND=0.0.0.0:8777
Environment=CLEANER_STORAGE_DIR=/var/cache/exiftool-webtool/jobs
EnvironmentFile=-/etc/default/exiftool-webtool
ExecStart=/usr/bin/gunicorn --bind ${CLEANER_BIND} --workers 2 --threads 4 --timeout 300 --access-logfile - 'app:create_app()'
Restart=on-failure

# Uploads and cleaned files live here; wiped on uninstall.
CacheDirectory=exiftool-webtool
CacheDirectoryMode=0700

# Hardening: the service can only write to its cache directory and /tmp.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
