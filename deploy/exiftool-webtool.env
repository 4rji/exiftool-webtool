# Settings for the exiftool-webtool service.
# Installed to /etc/default/exiftool-webtool; edit there, then:
#   sudo systemctl restart exiftool-webtool

# Address and port gunicorn listens on.
# Use 127.0.0.1:8777 if a reverse proxy (nginx, caddy) sits in front.
CLEANER_BIND=0.0.0.0:8777

# Maximum size of one upload request (all files together), in MB.
CLEANER_MAX_UPLOAD_MB=200

# Cleaned files and their metadata reports are deleted after this many minutes.
CLEANER_RETENTION_MINUTES=30
